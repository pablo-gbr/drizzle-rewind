{
  "name": "drizzle-down",
  "version": "0.1.1",
  "description": "Down migrations, rollback, status and repair for Drizzle ORM on PostgreSQL.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "drizzle-down": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "drizzle-kit",
    "migrations",
    "down-migration",
    "rollback",
    "postgres",
    "postgresql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "drizzle-kit": "^0.31.0",
    "pg": ">=8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "author": "Anas Ismail <anas.ismail1911@gmail.com> (https://anasismail.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnasIsmai1/drizzle-down.git"
  },
  "homepage": "https://github.com/AnasIsmai1/drizzle-down#readme",
  "bugs": {
    "url": "https://github.com/AnasIsmai1/drizzle-down/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  }
}
