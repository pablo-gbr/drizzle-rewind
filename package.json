{
  "name": "drizzle-rewind",
  "version": "0.1.1",
  "description": "Safe down migration generation and rollback helpers for Drizzle ORM on PostgreSQL and MariaDB/MySQL.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bin": {
    "drizzle-rewind": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "drizzle-kit",
    "migrations",
    "down-migration",
    "rollback",
    "postgres",
    "postgresql",
    "mysql",
    "mariadb"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "drizzle-kit": "^0.31.0",
    "mysql2": ">=3",
    "pg": ">=8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "author": "drizzle-rewind contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablo-gbr/drizzle-rewind.git"
  },
  "homepage": "https://github.com/pablo-gbr/drizzle-rewind#readme",
  "bugs": {
    "url": "https://github.com/pablo-gbr/drizzle-rewind/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  }
}
